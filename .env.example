# --- AI provider (analysis + chat + key evidence synthesis) ---
# Auto-detected in this order unless AI_PROVIDER forces one: azure > openai > gemini.
# Recommended: Gemini 2.5 Flash - the model version already proven working in
# production across CaseBuddy (lexsim) and case-companion's OCR fallback path.
# AI_PROVIDER=gemini

GEMINI_API_KEY=your_gemini_api_key
# GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
# GEMINI_CHAT_MODEL=gemini-2.5-flash

# OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Optional: Override default OpenAI models
# OPENAI_ANALYSIS_MODEL=gpt-4o
# OPENAI_CHAT_MODEL=gpt-4o

# Optional: Caching configuration
# AI_ENABLE_CACHE=true
# AI_CACHE_TTL_MS=3600000

# Supabase (client + service role + storage)
# Create a Supabase project at https://supabase.com
# Files and manifests are stored in Supabase Storage bucket 'discovery-files'
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Azure Document Intelligence (High-accuracy OCR for PDFs, scanned docs, images)
# Used for extracting text before AI analysis - best accuracy for legal documents
# Get endpoint and key from: https://portal.azure.com > Create "Document Intelligence" resource
# Required for best results; optional if using generic text extraction fallback
AZURE_DOC_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTELLIGENCE_KEY=your_azure_doc_intelligence_key

# Azure OpenAI (LLM fallback/primary)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_KEY=your_azure_openai_key
# Set a deployment for analysis (JSON structured output) and optionally a separate one for chat
AZURE_OPENAI_DEPLOYMENT_ANALYSIS=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_CHAT=gpt-4o-mini
# Optional: override API version if needed
# AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Vision (optional OCR for images; not used unless wired up)
# AZURE_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com/
# AZURE_VISION_KEY=your_azure_vision_key

# --- Transcription provider (audio/video files) ---
# Auto-detected unless TRANSCRIPTION_PROVIDER forces one: deepgram > assemblyai.
# Pipeline: ffmpeg strips + downsamples audio from video first (see
# lib/mediaTranscoder.ts - requires the `ffmpeg` binary; installed via
# Dockerfile in production), then the audio is sent to the provider below.
# TRANSCRIPTION_PROVIDER=deepgram

# Deepgram (recommended - fastest + most accurate general-purpose ASR)
# Get your key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key
# DEEPGRAM_MODEL=nova-3

# AssemblyAI (fallback if Deepgram is unavailable or fails)
# ASSEMBLYAI_API_KEY=your_assemblyai_key
# ASSEMBLYAI_SPEECH_MODEL=universal
